# Environment Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Multi-Tenant SaaS Website Management Platform"
API_V1_STR=/api/v1

# Security & Tokens
SECRET_KEY=generate-a-strong-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Password Policy & Account Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Database Configuration (PostgreSQL in production)
# Format: postgresql+asyncpg://user:password@localhost:5432/nofa_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nofa_db
# For running tests or SQLite async dev: sqlite+aiosqlite:///./test.db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://127.0.0.1:3000"]

# Storage Configuration
# Options: "local" or "s3"
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage
# S3 / MinIO Configuration
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=saas-platform-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# Super Admin Initial Seed (Optional for auto-bootstrap)
FIRST_SUPERADMIN_EMAIL=superadmin@platform.com
FIRST_SUPERADMIN_PASSWORD=SuperAdmin@123456
FIRST_SUPERADMIN_NAME="Super Administrator"

